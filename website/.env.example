# Supabase (get from https://app.supabase.com → Project Settings → API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Resend (https://resend.com) – only needed on Vercel (server-side)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address – must be a verified domain in Resend
# RESEND_FROM=DENUCHANGE Workshop <noreply@yourdomain.com>
