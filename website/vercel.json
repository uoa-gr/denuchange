{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|_vercel/|DENUCHANGE_Program\\.pdf$).*)",
      "destination": "/index.html"
    }
  ]
}
