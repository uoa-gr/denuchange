{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(browser-refresh\\.js|sw-refresh\\.js|sw\\.js|version\\.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|_vercel/|assets/|DENUCHANGE_Program\\.pdf$).*)",
      "destination": "/index.html"
    }
  ]
}
